# --- Gmail SMTP (pengirim) ---
# Gunakan Gmail App Password (bukan password akun biasa):
# https://myaccount.google.com/apppasswords  (butuh 2-Step Verification aktif dulu)
GMAIL_USER=akun_pengirim@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# --- Tujuan forward ---
MAIL_TO=tujuan@gmail.com

# --- Filter rules untuk forward-ke-Gmail generik ---
# CATATAN PENTING: jalur ini TERPISAH dari intake tiket NAC di bawah.
# Form tiket sudah otomatis dikirim ke Gmail oleh NAC_TICKET_ENABLED.
#
# Kalau HANYA ingin form tiket yang masuk email, set ini false:
GMAIL_FORWARD_ENABLED=false
#
# (Mengosongkan FILTER_KEYWORDS TIDAK mematikan fitur — justru sebaliknya,
#  artinya semua pesan diforward. Pakai GMAIL_FORWARD_ENABLED=false.)

# Hanya forward pesan yang mengandung salah satu keyword ini (pisahkan koma).
# Berlaku hanya kalau GMAIL_FORWARD_ENABLED=true.
FILTER_KEYWORDS=

# Hanya forward dari nomor tertentu, format 62xxxxxxxxxx (pisahkan koma).
# Kosongkan untuk terima dari semua nomor.
FILTER_SENDERS=

# true = abaikan pesan dari grup, false = ikut proses pesan grup juga
EXCLUDE_GROUPS=true

# --- AI Auto-Reply (Kimi / Moonshot AI) ---
# true untuk aktifkan fitur auto-reply pakai AI, false untuk matikan
AI_AUTO_REPLY_ENABLED=false

# Dapatkan API key di https://platform.moonshot.ai (butuh top-up minimal $1)
KIMI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Model Kimi yang dipakai. kimi-k2.6 cukup buat auto-reply chat biasa,
# kimi-k3 lebih kuat tapi lebih mahal.
KIMI_MODEL=kimi-k2.6

# Base URL API Kimi (default sudah benar, biasanya nggak perlu diubah)
KIMI_BASE_URL=https://api.moonshot.ai/v1

# Persona/instruksi buat AI saat membalas. Boleh diubah sesuai kebutuhan.
AI_SYSTEM_PROMPT="Kamu adalah Helpdesk IT Jaringan & NAC di Bank Negara Indonesia (BNI). Kamu memiliki knowledge teknis sebagai L1 Network Security Engineer yang memahami Aruba ClearPass Policy Manager (CPPM) dan Network Access Control (NAC), namun peran utamamu di sini adalah sebagai HELPDESK yang ramah, sopan, interaktif, dan komunikatif. Tugasmu melayani pegawai BNI yang terkendala akses jaringan Intranet (Wi-Fi maupun kabel LAN).\n\nPanduan Penanganan:\n1. Sapaan & Karakter: Sapa rekan dengan hangat dan ramah ('Halo Rekan BNI', 'Selamat pagi/siang/malam Rekan'). Bersikaplah sangat interaktif dan suportif.\n2. Cek Relevansi Kendala & Aturan Eskalasi:\n- KENDALA RANAH TIM KITA (TIM NAC): Jika status ClearPass masih Unknown atau Quarantined (atau belum dipastikan statusnya), atau jika rekan mengalami kendala konektivitas seperti tidak bisa ping ke arah gateway, tidak bisa ping ke arah ClearPass (192.168.102.23), atau tidak bisa akses ke mana-mana (termasuk jika sudah ping ke 8.8.8.8 tetap tidak bisa / RTO), maka kendala ini WAJIB ditangani oleh tim kita (Tim NAC) terlebih dahulu, jangan langsung diarahkan ke tim lain. Kumpulkan data rekan sesuai format untuk dicek oleh tim teknis/engineer kita.\n- KENDALA VPN: Jika ada rekan yang bertanya atau terkendala terkait VPN, langsung arahkan ke tim NPS Firewall (085220968722).\n- ESKALASI KE TIM LAIN (Setelah ClearPass Healthy & bukan kendala dasar NAC): Baru setelah status ClearPass dipastikan sudah Healthy/normal dari sisi NAC dan koneksi dasar aman namun kendala masih terjadi, arahkan rekan ke kontak tim terkait berikut:\n  * SDD Desktop (087855173667): Jika ClearPass sudah healthy tapi ada kendala umum pada laptop seperti perlu install aplikasi, pengecekan settingan di laptop, atau perlu leverage ke admin privilege untuk tujuan tertentu.\n  * ITSM SDD Backbone (081219401339): Jika dari sisi ClearPass/NAC sudah dipastikan aman/Healthy namun rekan masih mengalami issue pada koneksi kabel LAN.\n  * ITSM Firewall (081313917077): Jika ClearPass sudah healthy tapi rekan spesifik tidak bisa akses aplikasi tertentu.\n  * IT Service Desk BNI: Jika kendala murni di luar jaringan (email Outlook, core banking, printer, reset password, dsb).\n3. Kasus Khusus Whitelist (Keywords: 'wl', 'WL', 'whitelist'): Jika ada rekan yang chat meminta whitelist dengan keyword tersebut, kemungkinan besar pengirimnya adalah rekan tim SDD Desktop. Ubah gaya respons menjadi lebih santai / tidak terlalu baku dan tidak bertele-tele (seperti sesama rekan kerja IT), namun tetap sopan, formal, dan profesional. Ketika minta WL cukup minta mac-address, npp dan lokasi saja. Kurangi penggunaan emoticon (jangan berlebihan). Pastikan data MAC Address dan perangkat yang ingin di-whitelist/dicek jelas.\n4. Pengumpulan Data Kendala: Jika rekan melaporkan kendala Intranet tetapi BELUM mengisi data lengkap, mintalah secara ramah untuk mengisi format berikut:\nName & NPP:\nHostname:\nMAC Address:\nIP Address:\nDivisi:\nDepartment:\nLokasi:\nLantai:\nKendala:\n(Bantu berikan panduan singkat jika rekan belum tahu cara cek Hostname atau MAC Address di laptopnya).\n5. Setelah Form Diisi: JIKA REKAN SUDAH MENGISI FORM TERSEBUT (atau mengirimkan pesan dengan format Name & NPP), informasikan bahwa data kendala sudah diterima dan saat ini SEDANG DILAKUKAN PENGECEKAN oleh tim teknis/engineer kita. Minta rekan untuk menunggu hasil pengecekan.\n6. Gaya Respon: Singkat, padat, rapi, ramah, dan komunikatif untuk WhatsApp. Tidak perlu mencoba untuk bold teks (jangan gunakan format tulisan tebal atau tanda bintang * untuk menebalkan teks, gunakan teks biasa/plain text saja).\n7. Respons Ucapan Terima Kasih: Jika user mengucapkan 'makasih', 'terima kasih', 'thanks', atau sejenisnya, cukup balas singkat saja seperti 'Sama-sama Rekan' atau 'Sama-sama Mas/Mba'. JANGAN berlebihan, jangan menambahkan paragraf panjang atau kalimat motivasi. Cukup singkat dan natural (tetap sertakan '- ITSM Bot' di baris akhir).\n8. Penanda Bot (Signature): Pada akhir setiap pesan yang kamu kirimkan tanpa terkecuali, WAJIB selalu cantumkan keterangan '- ITSM Bot' di baris paling akhir (beri pemisah satu baris kosong sebelumnya) untuk menandakan bahwa pesan ini dibalas otomatis oleh bot."

# WAJIB diisi — pesan hanya akan dibalas AI kalau mengandung salah satu
# keyword ini (pisahkan koma). Kalau dikosongkan, AI auto-reply TIDAK aktif
# sama sekali (mencegah auto-reply ke semua orang tanpa sengaja).
AI_TRIGGER_KEYWORDS=tanya,help,info,tes,halo,tolong,kendala,min,malam,mohon,bantu,cek,laptop,mas,mba,kak,gan,pagi,siang,sore,minta,gabisa,tidak bisa,error,wifi,intranet,wl,whitelist,vpn,ping,gateway

# Jeda minimum (detik) sebelum AI boleh membalas nomor yang sama lagi,
# supaya nggak boros biaya API kalau ada yang spam trigger keyword.
# Naikkan (mis. 30-60) kalau sering kena rate_limit_reached_error.
AI_COOLDOWN_SECONDS=10

# Batas panjang balasan AI. PENTING: Kimi menghitung kuota rate limit dari
# (token request + max_tokens), bukan dari panjang jawaban sebenarnya.
# Makin kecil, makin hemat kuota di tier rendah.
KIMI_MAX_TOKENS=300

# Berapa kali coba ulang saat kena 429 (rate limit), pakai exponential backoff.
KIMI_MAX_RETRY=3

# Jumlah pesan terakhir per chat yang dikirim ke AI sebagai konteks percakapan.
# Bot membaca history dari file log saat startup dan sebelum membalas,
# sehingga AI paham konteks percakapan sebelumnya walaupun bot di-restart.
# Semakin tinggi, AI makin paham konteks tapi makin boros token.
AI_HISTORY_LIMIT=20

# --- NAC/ClearPass Ticket Intake (parsing di Apps Script) ---
# true untuk aktifkan: forward chat format NAC ke Gmail + polling konfirmasi.
NAC_TICKET_ENABLED=false

# URL Web App hasil deploy Apps Script (lihat gas-nac-ticket-intake/Code.gs),
# diakhiri /exec. Dipakai bot buat polling antrian konfirmasi.
GAS_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXX/exec

# Harus SAMA PERSIS dengan Script Property "SHARED_SECRET" di Apps Script
GAS_SHARED_SECRET=isi-string-rahasia-bebas

# Email tujuan forward chat mentah. Default = GMAIL_USER (kirim ke diri sendiri).
# HARUS akun yang sama dengan pemilik Apps Script / Google Sheet, karena
# Apps Script membaca inbox akun itu.
NAC_INTAKE_EMAIL=

# Tag subject email intake (default [NAC-INTAKE]) — harus sama dengan
# SUBJECT_TAG di Code.gs.
NAC_SUBJECT_TAG=[NAC-INTAKE]

# Interval bot cek antrian konfirmasi (detik). Kombinasi dengan trigger
# Apps Script (1 menit) menentukan total latensi balasan ke user.
POLL_INTERVAL_SECONDS=20

# true = otomatis balas user dengan nomor tiket setelah tiket dibuat
NAC_CONFIRM_REPLY=true

# ==========================================================
# PEREKAMAN TRANSKRIP PERCAKAPAN (chat log)
# ==========================================================
# Merekam SEMUA pesan tanpa filter keyword, dua arah (pesan user maupun
# balasan operator dari device lain), satu file JSONL per chat.
# Ini sumber data untuk dianalisa tools AI lain.
CHAT_LOG_ENABLED=true

# Folder penyimpanan log (relatif terhadap folder project)
CHAT_LOG_DIR=logs

# true = jangan rekam percakapan grup
CHAT_LOG_EXCLUDE_GROUPS=false

# Nama yang dipakai untuk pesan yang dikirim dari akun sendiri/operator,
# muncul di transkrip sebagai pengirim.
OPERATOR_LABEL=ITSM NAC BNI

# Folder hasil export
EXPORT_DIR=exports

# Zona waktu untuk penulisan jam di transkrip (7 = WIB, 8 = WITA, 9 = WIT)
TZ_OFFSET_HOURS=7

# Otomatis hapus folder auth_info ketika bot dihentikan manual dengan Ctrl+C (true/false)
# Default false (folder auth_info hanya dihapus jika sesi logout/disconnect dari WhatsApp atau diperintah 'cut' di console)
DELETE_AUTH_ON_EXIT=false
